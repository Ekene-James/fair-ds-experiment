          "name": "value_end_mln",
          "dataType": "sc:Number",
          "unitText": "million EUR",
          "description": "Final player value in millions."
        },

        {
          "@type": "cr:Field",
          "name": "value_delta_mln",
          "dataType": "sc:Number",
          "unitText": "million EUR",
          "description": "Difference between final and initial player value in millions."
