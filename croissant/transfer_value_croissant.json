      "field": [
        {
          "@type": "cr:Field",
          "name": "player_name",
          "dataType": "sc:Text",
          "description": "Player name."
        },

        {
          "@type": "cr:Field",
          "name": "position",
          "dataType": "sc:Text",
          "description": "Playing position."
        },

        {
          "@type": "cr:Field",
          "name": "nationality",
          "dataType": "sc:Text",
          "description": "Player nationality."
        },

        {
          "@type": "cr:Field",
          "name": "club_name",
          "dataType": "sc:Text",
          "description": "Football club name."
        },

        {
          "@type": "cr:Field",
          "name": "season",
          "dataType": "sc:Integer",
          "description": "Season year."
        },

        {
          "@type": "cr:Field",
          "name": "age_then",
          "dataType": "sc:Number",
          "unitText": "years",
          "description": "Player age during the observed season."
        },

        {
