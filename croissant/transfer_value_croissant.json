          "unitText": "assists",
          "description": "Total assists recorded."
        },

        {
          "@type": "cr:Field",
          "name": "penalty_kicks",
          "dataType": "sc:Integer",
          "unitText": "penalties",
          "description": "Penalty kicks scored."
        },

        {
          "@type": "cr:Field",
          "name": "total_minutes",
          "dataType": "sc:Number",
          "unitText": "minutes",
          "description": "Total minutes played."
        },

        {
          "@type": "cr:Field",
          "name": "total_goals",
