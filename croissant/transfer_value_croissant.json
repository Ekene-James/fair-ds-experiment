  },
  "@type": "sc:Dataset",
  "name": "Transfer Value Determinants Dataset",
  "description": "Dataset containing football player transfer-market observations and performance metrics across multiple seasons. Used for transfer value prediction experiments.",
  "keywords": [
    "football",
    "soccer",
    "transfer value",
    "sports analytics",
    "machine learning"
  ],
  "license": "Academic Use",
  "creator": {
    "@type": "Person",
    "name": "Nisanov"
  },
  "url": "https://test.dbrepo.tuwien.ac.at/database/be8863ae-9794-4ee2-a964-3e22133b3840",
  "distribution": {
    "@type": "cr:FileObject",
    "name": "Nisanov_final_data.xlsx",
    "encodingFormat": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "contentUrl": "https://test.dbrepo.tuwien.ac.at/database/be8863ae-9794-4ee2-a964-3e22133b3840"
  },
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "name": "transfer_value_observation",
      "description": "Transfer-market observations collected across multiple football seasons.",
      "field": [
        {
          "@type": "cr:Field",
          "name": "player_name",
          "dataType": "sc:Text",
          "description": "Player name."
        },
        {
          "@type": "cr:Field",
          "name": "position",
          "dataType": "sc:Text",
          "description": "Playing position."
        },
        {
          "@type": "cr:Field",
          "name": "nationality",
          "dataType": "sc:Text",
          "description": "Player nationality."
        },
        {
          "@type": "cr:Field",
          "name": "age_then",
          "dataType": "sc:Number",
          "unitText": "years",
          "description": "Player age during the observed season."
        },
        {
          "@type": "cr:Field",
          "name": "age_now",
          "dataType": "sc:Number",
          "unitText": "years",
          "description": "Current player age."
        },
        {
          "@type": "cr:Field",
          "name": "club_name",
          "dataType": "sc:Text",
          "description": "Football club name."
        },
        {
          "@type": "cr:Field",
          "name": "club_performance",
          "dataType": "sc:Number",
          "description": "Club performance indicator."
        },
        {
          "@type": "cr:Field",
          "name": "relegation",
          "dataType": "sc:Boolean",
          "description": "Whether the club was relegated."
        },
        {
          "@type": "cr:Field",
          "name": "success_or_not",
          "dataType": "sc:Boolean",
          "description": "Whether the transfer was considered successful."
        },
        {
          "@type": "cr:Field",
          "name": "total_games",
          "dataType": "sc:Integer",
          "unitText": "matches",
          "description": "Total games played."
        },
        {
          "@type": "cr:Field",
          "name": "assists",
          "dataType": "sc:Integer",
          "unitText": "assists",
          "description": "Total assists recorded."
        },
        {
          "@type": "cr:Field",
          "name": "penalty_kicks",
          "dataType": "sc:Integer",
          "unitText": "penalties",
          "description": "Penalty kicks scored."
        },
        {
          "@type": "cr:Field",
          "name": "total_minutes",
          "dataType": "sc:Number",
          "unitText": "minutes",
          "description": "Total minutes played."
        },
        {
          "@type": "cr:Field",
          "name": "total_goals",
          "dataType": "sc:Integer",
          "unitText": "goals",
          "description": "Total goals scored."
        },
        {
          "@type": "cr:Field",
          "name": "height",
          "dataType": "sc:Number",
          "unitText": "centimeters",
          "description": "Player height."
        },
        {
          "@type": "cr:Field",
          "name": "start_value",
          "dataType": "sc:Number",
          "unitText": "EUR",
          "description": "Initial player market value."
        },
        {
          "@type": "cr:Field",
          "name": "end_value",
          "dataType": "sc:Number",
          "unitText": "EUR",
          "description": "Final player market value."
        },
        {
          "@type": "cr:Field",
          "name": "delta_value",
          "dataType": "sc:Number",
          "unitText": "EUR",
          "description": "Difference between final and initial market value."
        },
        {
          "@type": "cr:Field",
          "name": "value_0_mln",
          "dataType": "sc:Number",
          "unitText": "million EUR",
          "description": "Initial player value in millions."
        },
        {
          "@type": "cr:Field",
          "name": "value_end_mln",
          "dataType": "sc:Number",
          "unitText": "million EUR",
          "description": "Final player value in millions."
        },
        {
          "@type": "cr:Field",
          "name": "value_delta_mln",
          "dataType": "sc:Number",
          "unitText": "million EUR",
          "description": "Difference between final and initial value in millions."
        },
        {
          "@type": "cr:Field",
          "name": "season",
          "dataType": "sc:Integer",
          "description": "Season year."
        }
      ]
    }
  ]
}
