# 4. Helper — Get all tables

```python
def get_tables_by_name(client, database_id):
    """
    Returns:
        {
            table_name: table_object
        }
    """

    tables = client.get_tables(database_id)

    return {
        t.internal_name: t
        for t in tables
    }
```

---

# 5. Helper — Safe View Creation

```python
def create_view_safe(client, database_id, name, query):
    """
    Creates a DBRepo view only if it does not already exist.
    """

    existing_views = client.get_views(database_id)

    existing = {
        v.name: v.id
        for v in existing_views
    }

    if name in existing:
        print(f"[SKIP] View already exists: {name}")
        return existing[name]

    view = client.create_view(
        database_id=database_id,
        name=name,
        query=query,
        is_public=True,
        is_schema_public=True,
    )

    print(f"[OK] Created view: {name}")

    return view.id
```

---

# 6. Helper — Fully Qualified Column Extraction

IMPORTANT:

This helper fixes the original DBRepo error:

```text
MalformedError:
column(s) are not in table.column notion
```

It also avoids the later NumPy inhomogeneous-shape issue by returning a FLAT LIST.

```python

def get_primary_columns(
    table_by_name,
    table_name,
    exclude=None,
):
    """
    Returns a FLAT LIST of fully-qualified columns.

    Example:
        [
            "player.goals",
            "player.assists"
        ]
    """

    if exclude is None:
        exclude = []

    tbl = table_by_name[table_name]

    columns = []

    for col in tbl.columns:

        if col.internal_name in exclude:
            continue

        columns.append(
            f"{table_name}.{col.internal_name}"
        )

    return columns
```

